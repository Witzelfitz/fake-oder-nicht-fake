{
  "name": "fake-oder-nicht-fake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live-Medienquiz für den Digimärt Alpnach – Socket.IO und SQLite",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check-content.js",
    "docs:export": "node scripts/export-handouts.js",
    "verify": "npm run check && npm test",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-db.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "socket.io-client": "4.8.4"
  }
}
